---
import Base from '../layouts/Base.astro'
import PageHero from '../components/PageHero.astro'
import { services, site } from '../data/site'
---

<Base
  title="Contact"
  description="Tell Booklith about your book, your goals, and the support you need. Email hello@booklith.name.ng or send an inquiry online."
>
  <PageHero
    eyebrow="Contact"
    title="Let’s Grow <em>Your Book.</em>"
    intro="Tell us about your book, your goals, and the support you need. The Booklith team can review your inquiry and help identify an appropriate next step."
    crumbs={[{ label: 'Contact' }]}
  />

  <section class="section section--white">
    <div class="wrap contact-grid">
      <div>
        <form
          class="form"
          name="contact"
          method="POST"
          action="/thank-you"
          data-netlify="true"
          netlify-honeypot="bot-field"
          data-contact-form
          aria-describedby="form-note"
        >
          <input type="hidden" name="form-name" value="contact" />
          <input type="hidden" name="subject" value="New Booklith inquiry" />
          <p class="hp" aria-hidden="true">
            <label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <p id="form-note" class="field-hint">Fields marked <span class="req" aria-hidden="true">*</span><span class="sr-only">with an asterisk</span> are required.</p>

          <div class="form-alert" role="alert" tabindex="-1" hidden data-form-alert></div>

          <div class="form-row">
            <div class="field">
              <label for="name">Name <span class="req" aria-hidden="true">*</span></label>
              <input id="name" name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby="name-error" />
              <p class="field-error" id="name-error" data-error-for="name"></p>
            </div>
            <div class="field">
              <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="200" aria-describedby="email-error" />
              <p class="field-error" id="email-error" data-error-for="email"></p>
            </div>
          </div>

          <div class="form-row">
            <div class="field">
              <label for="book-title">Book Title <span class="req" aria-hidden="true">*</span></label>
              <input id="book-title" name="book-title" type="text" required maxlength="200" aria-describedby="book-title-error" />
              <p class="field-error" id="book-title-error" data-error-for="book-title"></p>
            </div>
            <div class="field">
              <label for="book-link">Author Website / Book Link <span class="opt">(optional)</span></label>
              <input id="book-link" name="book-link" type="url" inputmode="url" placeholder="https://" maxlength="300" aria-describedby="book-link-error" />
              <p class="field-error" id="book-link-error" data-error-for="book-link"></p>
            </div>
          </div>

          <div class="field">
            <label for="service">What do you need help with?</label>
            <select id="service" name="service">
              <option value="">Select a service</option>
              {services.map((s) => <option value={s.name} data-slug={s.slug}>{s.name}</option>)}
              <option value="Several services">Several services</option>
              <option value="Not sure yet">Not sure yet</option>
            </select>
          </div>

          <div class="field">
            <label for="message">Message <span class="req" aria-hidden="true">*</span></label>
            <textarea id="message" name="message" required maxlength="5000" rows="7" aria-describedby="message-hint message-error"></textarea>
            <p class="field-hint" id="message-hint">Tell us a little about your book, your goals, and your timing.</p>
            <p class="field-error" id="message-error" data-error-for="message"></p>
          </div>

          <div>
            <button class="btn" type="submit" data-submit>Send Inquiry</button>
          </div>
        </form>

        <div class="form-success" role="status" tabindex="-1" hidden data-form-success>
          <h2 class="h3">Thank you — your inquiry has been sent.</h2>
          <p>The Booklith team has received your message and will review it. We’ll reply to the email address you provided.</p>
          <p style="margin-top:1.5rem"><a class="text-link" href="/our-work">Explore our work while you wait <span class="arrow" aria-hidden="true">→</span></a></p>
        </div>
      </div>

      <aside class="contact-panel" aria-label="Contact details">
        <dl>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          <div>
            <dt>Website</dt>
            <dd><a href={site.url}>{site.domain}</a></dd>
          </div>
          <div>
            <dt>What happens next</dt>
            <dd style="font-family:var(--sans);font-size:0.98rem;color:var(--muted-light)">
              We read every inquiry and respond by email with an appropriate next step for your book.
            </dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>
</Base>

<style is:global>
  .contact-grid {
    display: grid;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 1000px) {
    .contact-grid {
      grid-template-columns: 1.5fr 0.8fr;
      gap: 5rem;
    }
    .contact-panel {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
</style>

<script>
  import { initContactForm } from '../scripts/contact-form'
  initContactForm()
</script>
