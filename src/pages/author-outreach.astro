---
import ServicePage from '../components/ServicePage.astro'
---

<ServicePage
  slug="author-outreach"
  metaTitle="Author Outreach"
  title="Help More of the Right People <em>Discover Your Work.</em>"
  description="Booklith supports author outreach planning, professional communication, reader visibility activities, and audience connection — without guaranteed placements."
  intro="Outreach is about introducing you and your book to people who are likely to care. We help you plan it thoughtfully, communicate professionally, and pursue opportunities that suit your work."
  pillarsHeading="Thoughtful outreach, professionally handled."
  pillars={[
    { t: 'Outreach planning', d: 'Identify the kinds of audiences, communities, and opportunities that make sense for your book.' },
    { t: 'Professional communication', d: 'Well-prepared introductions, pitches, and follow-ups that represent you with care.' },
    { t: 'Author visibility', d: 'Activities that help readers encounter you and your work more often, in the right places.' },
    { t: 'Reader connection', d: 'Support for reader-facing moments such as events, conversations, and community engagement.' },
    { t: 'Ready-to-share materials', d: 'Bios, summaries, and visuals prepared so you can respond quickly when opportunities arise.' },
    { t: 'Coordinated with your brand', d: 'Outreach that reflects the same positioning and identity as the rest of your presence.' },
  ]}
  examplesHeading="Reader connection in practice."
  examples={[
    { id: 'client-project-5', note: 'Imagery and a short film of the author meeting and talking with readers in a bookshop setting.' },
  ]}
>
  <section class="section section--cream">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow reveal">Honest expectations</p>
        <h2 class="h2 reveal" data-delay="1">Assistance with outreach — not guaranteed coverage.</h2>
      </div>
      <div class="split-panels">
        <div class="panel reveal">
          <h3 class="h4">What outreach support means</h3>
          <ul class="check-list">
            <li>Planning who to approach and why</li>
            <li>Preparing professional, well-targeted communication</li>
            <li>Supporting reader visibility activities</li>
            <li>Helping you follow up on appropriate opportunities</li>
          </ul>
        </div>
        <div class="panel panel--dark reveal" data-delay="1">
          <h3 class="h4">What no one can promise</h3>
          <ul class="check-list">
            <li>Guaranteed media appearances or press coverage</li>
            <li>Guaranteed placements, features, or reviews</li>
            <li>Guaranteed endorsements or partnerships</li>
            <li>Specific audience or sales numbers</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</ServicePage>
