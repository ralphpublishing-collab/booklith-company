---
import Base from '../layouts/Base.astro'
import PageHero from '../components/PageHero.astro'
import CtaBand from '../components/CtaBand.astro'
import { stages } from '../data/site'

const detail: Record<string, { involves: string[]; links: { label: string; href: string }[] }> = {
  Understand: {
    involves: ['An initial conversation about your book and goals', 'Reviewing your current materials and presence', 'Agreeing priorities and the services that fit'],
    links: [{ label: 'For Authors', href: '/for-authors' }],
  },
  Position: {
    involves: ['Clarifying the book’s promise and audience', 'Defining key messages and author positioning', 'Deciding what communication should emphasize'],
    links: [{ label: 'Book Marketing', href: '/author-marketing' }, { label: 'Author Branding', href: '/author-branding' }],
  },
  Create: {
    involves: ['Promotional graphics and campaign visuals', 'Author profiles, bios, and branded materials', 'Presentation and preparation materials'],
    links: [{ label: 'Creative Campaigns', href: '/creative-campaigns' }, { label: 'Publishing Support', href: '/publishing-support' }],
  },
  Connect: {
    involves: ['Planning appropriate outreach', 'Professional communication with relevant audiences', 'Supporting reader visibility activities'],
    links: [{ label: 'Author Outreach', href: '/author-outreach' }],
  },
  Grow: {
    involves: ['Keeping your presence consistent over time', 'Refreshing materials for new moments', 'Building a foundation for future books'],
    links: [{ label: 'Contact us', href: '/contact' }],
  },
}
---

<Base
  title="Our Approach"
  description="Booklith’s five-stage approach — Understand, Position, Create, Connect, Grow — shaped around each author’s goals and agreed services."
>
  <PageHero
    eyebrow="Our Approach"
    title="A Thoughtful Process. <em>A Stronger Book Presence.</em>"
    intro="Five stages that take a book from where it is today to a clearer, more consistent presence. Each stage is shaped around your goals and the services you choose."
    crumbs={[{ label: 'Our Approach' }]}
  />

  <section class="section section--white">
    <div class="wrap">
      <ol class="approach">
        {stages.map((s) => (
          <li class="approach__stage reveal">
            <div class="approach__n" aria-hidden="true">{s.n}</div>
            <div>
              <h2 class="h2">{s.name}</h2>
              <p class="lead" style="margin-top:1rem">{s.text}</p>
            </div>
            <div>
              <h3 class="approach__sub">This can involve</h3>
              <ul class="check-list">{detail[s.name].involves.map((x) => <li>{x}</li>)}</ul>
              <p class="approach__links">
                {detail[s.name].links.map((l) => <a class="text-link" href={l.href}>{l.label} <span class="arrow" aria-hidden="true">→</span></a>)}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--dark section--tight">
    <div class="wrap wrap--narrow" style="text-align:center">
      <p class="eyebrow reveal" style="justify-content:center">Shaped around you</p>
      <h2 class="h3 reveal" data-delay="1">Not every author needs every stage in the same depth.</h2>
      <p class="lead reveal" data-delay="2" style="margin:1.5rem auto 0">
        Deliverables depend on your goals and the services we agree together. Some authors begin with positioning;
        others need creative materials for a launch that is already planned. We’ll recommend a sensible starting point.
      </p>
    </div>
  </section>

  <CtaBand secondary={{ label: 'Explore Services', href: '/services' }} />
</Base>

<style is:global>
  .approach {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .approach__stage {
    display: grid;
    gap: 1.5rem 4rem;
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }
  .approach__stage:last-child {
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 960px) {
    .approach__stage {
      grid-template-columns: 9rem 1fr 1fr;
      align-items: start;
    }
  }
  .approach__n {
    font-family: var(--serif);
    font-size: clamp(3.5rem, 7vw, 6rem);
    line-height: 0.9;
    color: var(--gold);
  }
  .approach__sub {
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-text);
    margin-bottom: 0.5rem;
  }
  .approach__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
</style>
